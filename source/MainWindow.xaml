<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GATE Control · 非生物因素开服器 1.0.1" Width="1180" Height="800" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#101716" Foreground="#E6EAE3" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#E9B65D"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#93A29B"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#263530"/><Setter Property="Foreground" Value="#E6EAE3"/><Setter Property="BorderBrush" Value="#3A4D44"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E9B65D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E9B65D"/><Setter Property="BorderBrush" Value="#E9B65D"/><Setter Property="Foreground" Value="#142019"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101916"/><Setter Property="Foreground" Value="#E6EAE3"/><Setter Property="CaretBrush" Value="#E9B65D"/><Setter Property="BorderBrush" Value="#405247"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#566C4D"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#101916"/><Setter Property="Foreground" Value="#E6EAE3"/><Setter Property="CaretBrush" Value="#E9B65D"/><Setter Property="BorderBrush" Value="#405247"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="#15231A"/><Setter Property="Background" Value="#DCE5DA"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#15231A"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D8E1D7"/><Setter Property="Margin" Value="0,8,16,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#19231F"/><Setter Property="BorderBrush" Value="#2E3E34"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#A1B0A7"/><Setter Property="GroupName" Value="Navigation"/><Setter Property="Margin" Value="12,3"/><Setter Property="Padding" Value="16,14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavSurface" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#344234"/><Setter Property="Foreground" Value="#F0C579"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#28362D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15201A" BorderBrush="#2B3C30" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="24,32,20,30"><TextBlock Text="◈  GATE" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Foreground="#E9B65D"/><TextBlock Text="SERVER CONTROL" FontFamily="Consolas" FontSize="11" Foreground="#83977E" Margin="2,8,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="24,20"><Border Background="#284030" CornerRadius="4" Padding="9,5" HorizontalAlignment="Left"><TextBlock Text="非生物因素" Foreground="#ABC69D" FontSize="11"/></Border><TextBlock Text="独立社区工具  /  v1.0.1" Foreground="#718777" FontSize="11" Margin="0,12,0,0"/><TextBlock Text="本地控制 · 官方参数" Foreground="#718777" FontSize="11" Margin="0,5,0,0"/></StackPanel>
   <StackPanel><RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" Content="01    控制中心" IsChecked="True"/><RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="02    服务器设置"/><RadioButton x:Name="NavSandbox" Style="{StaticResource Nav}" Content="03    沙盒规则"/><RadioButton x:Name="NavSchedule" Style="{StaticResource Nav}" Content="04    定时任务"/><RadioButton x:Name="NavSaves" Style="{StaticResource Nav}" Content="05    存档与管理"/><RadioButton x:Name="NavLogs" Style="{StaticResource Nav}" Content="06    日志与帮助"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
   <Border BorderBrush="#29392E" BorderThickness="0,0,0,1" Padding="30,0"><Grid><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="控制中心" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="把繁琐留给程序，把时间留给探索。" Foreground="#93A29B" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#273529" Padding="13,8" CornerRadius="16"><TextBlock x:Name="StatusBadge" Text="●  未启动" Foreground="#C1D1B8"/></Border></Grid></Border>
   <Grid Grid.Row="1" Margin="30,24,22,8">
    <ScrollViewer x:Name="PageOverview"><StackPanel Margin="0,0,8,0">
     <Border Style="{StaticResource Card}" Background="#273728" Padding="26"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FACILITY OPERATIONS / 站点运行" FontFamily="Consolas" Foreground="#B4C19E" FontSize="11"/><TextBlock x:Name="HeroName" Text="你的地下设施，准备就绪。" FontSize="27" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock x:Name="HeroDetail" Text="确认服务器路径后，启动你的协作生存世界。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,22,0,0"><Button x:Name="StartButton" Content="▶  启动服务器" Style="{StaticResource Primary}" MinWidth="150" Margin="0,0,10,8"/><Button x:Name="StopButton" Content="停止" IsEnabled="False" Margin="0,0,10,8"/><Button x:Name="RestartButton" Content="重启" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◈" FontSize="84" Foreground="#B6BD7A" HorizontalAlignment="Center"/><TextBlock Text="SECTOR / 01" FontFamily="Consolas" Foreground="#94A580" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
     <UniformGrid Columns="3" Margin="0,0,-12,0"><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="进程运行时间" Style="{StaticResource Muted}"/><TextBlock x:Name="UptimeText" Text="00:00:00" FontFamily="Consolas" FontSize="27" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="进程内存" Style="{StaticResource Muted}"/><TextBlock x:Name="MemoryText" Text="—" FontFamily="Consolas" FontSize="27" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,16"><StackPanel><TextBlock Text="下次计划" Style="{StaticResource Muted}"/><TextBlock x:Name="NextTaskText" Text="未安排" FontSize="22" Margin="0,12,0,0"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="服务器文件" Style="{StaticResource Section}"/><TextBlock x:Name="DetectedPathText" Text="尚未选择目录" FontFamily="Consolas" Foreground="#B5C6AD"/><TextBlock x:Name="PathStatusText" Text="可在服务器设置中选择文件夹。" Style="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button x:Name="GoSettingsButton" Content="检查 / 修改设置" Margin="0,0,10,0"/><Button x:Name="OpenGameButton" Content="打开服务器目录"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="启动前小贴士" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="首次启动后，等待地图加载完成再加入。公网连接需要路由器和防火墙放行你设置的游戏端口；局域网发现还会使用 14001 端口。进程运行不等于公网已经可连接。" Style="{StaticResource Muted}"/><TextBlock Text="停止或定时重启前，建议在游戏内管理员界面保存世界。退出信号不是独立的强制存档命令。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"><StackPanel Margin="0,0,8,0">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="原生服务器位置" Style="{StaticResource Section}"/><DockPanel><Button x:Name="BrowseButton" Content="选择文件夹" DockPanel.Dock="Right" Margin="10,0,0,0"/><Button x:Name="DetectButton" Content="自动查找" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="RootBox" AutomationProperties.Name="服务器根目录"/></DockPanel><TextBlock Text="选择含 AbioticFactorServer.exe 的根目录。把本程序放入该目录后，启动时会自动识别。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="房间与世界" Style="{StaticResource Section}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="房间名称" Margin="0,0,0,7"/><TextBox x:Name="NameBox" MaxLength="120" AutomationProperties.Name="房间名称"/><TextBlock Text="房间密码（留空为无密码）" Margin="0,17,0,7"/><PasswordBox x:Name="ServerPasswordBox" AutomationProperties.Name="房间密码"/><TextBlock Text="玩家上限（1–24，官方建议不超过 6）" Margin="0,17,0,7"/><TextBox x:Name="PlayersBox" AutomationProperties.Name="玩家上限"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="世界存档名称" Margin="0,0,0,7"/><TextBox x:Name="WorldBox" AutomationProperties.Name="世界存档名称"/><TextBlock Text="管理员密码（可在游戏内认证）" Margin="0,17,0,7"/><PasswordBox x:Name="AdminPasswordBox" AutomationProperties.Name="管理员密码"/><TextBlock Text="允许的游戏平台" Margin="0,17,0,7"/><ComboBox x:Name="PlatformBox" AutomationProperties.Name="游戏平台"><ComboBoxItem Content="全部平台 / 跨平台" Tag=""/><ComboBoxItem Content="Steam PC" Tag="PC"/><ComboBoxItem Content="PlayStation" Tag="Playstation"/><ComboBoxItem Content="Xbox / Windows Store" Tag="Xbox"/></ComboBox></StackPanel></Grid></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="网络与运行" Style="{StaticResource Section}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="绑定本机 IPv4（留空为默认）" Margin="0,0,0,7"/><ComboBox x:Name="IpBox" IsEditable="True" AutomationProperties.Name="绑定IP"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="游戏端口" Margin="0,0,0,7"/><TextBox x:Name="PortBox" AutomationProperties.Name="游戏端口"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="查询端口" Margin="0,0,0,7"/><TextBox x:Name="QueryBox" AutomationProperties.Name="查询端口"/></StackPanel></Grid><WrapPanel Margin="0,12,0,0"><CheckBox x:Name="LanBox" Content="仅局域网"/><CheckBox x:Name="LocalIpsBox" Content="UseLocalIPs" ToolTip="局域网排错选项，可能影响互联网加入。"/><CheckBox x:Name="PerfBox" Content="性能线程"/><CheckBox x:Name="ConsoleBox" Content="显示原生控制台"/></WrapPanel><TextBlock Text="绑定地址必须属于本机网卡；公网 NAT 地址不应填在这里。默认端口为 7777 / 27015。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,16,0,0"><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="PreviewButton" Content="查看启动参数"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="PageSandbox" Visibility="Collapsed"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="为世界定制规则" Style="{StaticResource Section}"/><CheckBox x:Name="ManageSandboxBox" Content="启动时应用下方沙盒规则"/><TextBlock Text="规则写入独立配置目录，通过官方 SandboxIniPath 参数应用；不会提前创建世界存档目录。更换世界后，请先读取规则。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,16,0,0"><Button x:Name="LoadSandboxButton" Content="读取当前世界" Margin="0,0,10,0"/><Button x:Name="ResetSandboxButton" Content="恢复官方默认值" Margin="0,0,10,0"/><Button x:Name="SaveSandboxButton" Content="保存并应用规则" Style="{StaticResource Primary}"/></WrapPanel><TextBlock Text="搜索规则（中文名称或英文参数键）" Foreground="#93A29B" Margin="0,16,0,6"/><TextBox x:Name="SandboxSearch" Margin="0,0,0,0" AutomationProperties.Name="搜索沙盒规则" ToolTip="输入中文名称或英文参数键搜索"/><TextBlock x:Name="SandboxContextText" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border><StackPanel x:Name="SandboxPanel"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="PageSchedule" Visibility="Collapsed"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="让维护按时发生" Style="{StaticResource Section}"/><TextBlock Text="倒计时结束时正常停止或重启服务器。计划仅在本程序运行期间有效；关闭程序、手动停服或服务器提前退出会取消计划。" Style="{StaticResource Muted}"/><Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="等待时长（分钟，允许小数）" Margin="0,0,0,7"/><TextBox x:Name="MinutesBox" Text="60" AutomationProperties.Name="倒计时分钟"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="到时执行" Margin="0,0,0,7"/><ComboBox x:Name="TaskBox" SelectedIndex="0"><ComboBoxItem Content="关闭服务器"/><ComboBoxItem Content="重启服务器"/></ComboBox></StackPanel></Grid><CheckBox x:Name="RepeatBox" Content="重启成功后，按相同间隔继续循环" Margin="0,20,0,12"/><TextBlock Text="系统睡眠期间无法执行；唤醒后会处理已到期的任务。停服超时则取消重启，等待你检查。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,20,0,0"><Button x:Name="ScheduleButton" Content="设置倒计时" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="CancelScheduleButton" Content="取消计划"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前计划" Style="{StaticResource Section}"/><TextBlock x:Name="ScheduleStatusText" Text="没有待执行的计划" FontSize="23"/><TextBlock x:Name="ScheduleDetailText" Text="启动服务器后即可安排。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="PageSaves" Visibility="Collapsed"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="存档与备份" Style="{StaticResource Section}"/><TextBlock Text="备份和导入需要服务器已停止。导入会复制世界文件夹；如果同名目录已存在，程序会拒绝覆盖。" Style="{StaticResource Muted}"/><WrapPanel Margin="0,18,0,0"><Button x:Name="BackupButton" Content="备份当前世界为 ZIP" Style="{StaticResource Primary}" Margin="0,0,10,8"/><Button x:Name="ImportButton" Content="导入世界文件夹" Margin="0,0,10,8"/><Button x:Name="OpenSavesButton" Content="打开存档目录" Margin="0,0,10,8"/><Button x:Name="OpenBackupsButton" Content="打开备份目录" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="WorldsText" Style="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="个人存档位置：%LocalAppData%\AbioticFactor\Saved\SaveGames\你的 SteamID\Worlds。选择其中的单个世界文件夹。" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="管理员白名单" Style="{StaticResource Section}"/><TextBlock Text="每行一个 SteamID64（17 位数字）。保存时仅更新 Admin.ini 的 Moderators 节；保留封禁列表及其他配置。更改在下次启动生效。" Style="{StaticResource Muted}"/><TextBox x:Name="ModeratorsBox" AcceptsReturn="True" Height="105" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,16,0,14" AutomationProperties.Name="管理员SteamID列表"/><WrapPanel><Button x:Name="LoadAdminButton" Content="读取白名单" Margin="0,0,10,0"/><Button x:Name="SaveAdminButton" Content="保存白名单"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="踢人 / 封禁" Style="{StaticResource Section}"/><TextBlock Text="当前核实的官方文档没有提供外部踢人 API 或 RCON 命令。本版本通过管理员密码和白名单帮助你取得管理权限；玩家管理操作请进入游戏内管理员界面完成。" Style="{StaticResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="PageLogs" Visibility="Collapsed"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,16"><TextBlock Text="运行日志" Style="{StaticResource Section}" Margin="0"/><Button x:Name="RefreshLogsButton" Content="立即刷新" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="每两秒读取末尾日志；口令参数会被遮盖。原生日志仍可能包含玩家标识与地址，分享前请自行检查。" Style="{StaticResource Muted}" Margin="0,0,0,14"/><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" Height="290" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><WrapPanel Margin="0,16,0,0"><Button x:Name="ExportLogsButton" Content="导出当前日志" Margin="0,0,10,0"/><Button x:Name="ForceStopButton" Content="强制结束进程…" Foreground="#F2A89B" IsEnabled="False"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="文档与程序信息" Style="{StaticResource Section}"/><WrapPanel><Button x:Name="LaunchDocsButton" Content="官方启动参数 ↗" Margin="0,0,10,10"/><Button x:Name="SandboxDocsButton" Content="官方沙盒参数 ↗" Margin="0,0,10,10"/><Button x:Name="MigrationDocsButton" Content="存档迁移指南 ↗" Margin="0,0,10,10"/><Button x:Name="OpenProfileButton" Content="打开本地配置目录" Margin="0,0,10,10"/></WrapPanel><TextBlock Text="GATE Control 1.0.1 · 非官方独立工具，与 Deep Field Games 无隶属关系。仅调用你已有的服务器文件。本地配置中的密码使用当前 Windows 用户的 DPAPI 加密；游戏启动时仍会按原生要求传入进程参数。" Style="{StaticResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="#141E18" BorderBrush="#29392E" BorderThickness="0,1,0,0" Padding="30,0"><TextBlock x:Name="FooterText" Text="就绪" Foreground="#A5B49C" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
  </Grid>
 </Grid>
</Window>


